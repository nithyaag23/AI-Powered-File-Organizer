# ==============================================================================
# FileOrganizer AI - Environment Configuration Template
# Copy this file to '.env' and fill in your actual credentials.
# NEVER commit your real '.env' file containing secrets to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# Gmail SMTP Email Verification Settings
# ------------------------------------------------------------------------------
# Gmail SMTP server and port (587 with STARTTLS)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587

# Your full Gmail address
SMTP_USER=your-email@gmail.com

# 16-character Gmail App Password (NOT your regular Google password)
# Generated from: Google Account -> Security -> 2-Step Verification -> App Passwords
SMTP_PASSWORD=your-16-character-app-password

# Optional sender display email and name (defaults to SMTP_USER if omitted)
SMTP_FROM_EMAIL=your-email@gmail.com
SMTP_FROM_NAME=FileOrganizer AI

# Frontend base URL used to construct email verification links
FRONTEND_URL=http://localhost:5173

# Verification token lifespan in hours (default: 24)
VERIFICATION_TOKEN_EXPIRE_HOURS=24

# Resend verification cooldown in seconds (rate limiting, default: 60)
RESEND_RATE_LIMIT_SECONDS=60

# ------------------------------------------------------------------------------
# Ollama Local AI Embeddings (Optional)
# ------------------------------------------------------------------------------
OLLAMA_BASE_URL=http://127.0.0.1:11434
DEFAULT_EMBED_MODEL=nomic-embed-text
